# Stripe API Keys - Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret - Get this when you create a webhook endpoint in Stripe Dashboard
# Webhook URL: https://your-domain.vercel.app/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Your deployed URL (Vercel will give you this after first deploy)
BASE_URL=https://your-domain.vercel.app

# Supabase - Get these from your Supabase project: Settings -> API
# Project URL and the public "anon" key are safe to expose to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service-role key is SECRET. Used only by the webhook to record deposits.
# Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin portal super-admins (comma-separated emails). Anyone who signs in with
# one of these emails gets full admin access at /admin. Distributors do NOT go
# here -- they are created inside the Admin Portal and log in with their own
# accounts. Requires running supabase/admin-setup.sql.
ADMIN_EMAILS=you@example.com
